# ── Serveur ────────────────────────────────────────────────────────────────
PORT=3000

# Cles d'API acceptees pour authentifier le systeme RH (separees par des virgules)
API_KEYS=changeme-dev-key

# ── Base de donnees ───────────────────────────────────────────────────────
# Chemin du fichier SQLite. Utiliser ":memory:" pour une base ephemere (tests).
DB_PATH=./data/employees.db

# ── Active Directory / LDAP ──────────────────────────────────────────────
# Mode "live" : les operations sont envoyees a l'annuaire.
# Mode "dry-run" : les operations sont simulees et journalisees, utile en dev
# ou lorsque aucun controleur de domaine n'est accessible depuis cet environnement.
LDAP_MODE=dry-run

# URL du controleur de domaine. Utiliser ldaps:// (port 636) en production :
# la definition du mot de passe (unicodePwd) exige une connexion chiffree.
LDAP_URL=ldaps://dc01.example.local:636

LDAP_BIND_DN=CN=svc-hr-sync,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=changeme

# Base de recherche pour retrouver un utilisateur existant (par employeeID)
LDAP_BASE_DN=DC=example,DC=local

# OU de creation des nouveaux comptes et OU de mise en quarantaine des comptes
# desactives lors d'un depart.
LDAP_USERS_OU=OU=Employes,DC=example,DC=local
LDAP_DISABLED_OU=OU=Comptes Desactives,DC=example,DC=local

# Suffixe utilise pour construire le userPrincipalName (sAMAccountName@LDAP_DOMAIN)
LDAP_DOMAIN=example.local

# Mettre a "false" uniquement si le certificat du LDC utilise une autorite
# interne non installee sur ce serveur (deconseille en production).
LDAP_TLS_REJECT_UNAUTHORIZED=true
